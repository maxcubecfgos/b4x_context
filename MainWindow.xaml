<Window x:Class="b4x_context.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:b4x_context"
        mc:Ignorable="d"
        Title="B4X_Context" Width="1050" Height="720" MinWidth="920" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================================================
             MAIN CONTENT — Two-pane layout
             ============================================================ -->
        <Grid Grid.Row="0" Margin="14,14,14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============================================================
                 LEFT — FILES PANEL
                 ============================================================ -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Toolbar — compact single line (PromptPacker style) -->
                    <Border Grid.Row="0" Background="{StaticResource HeaderBackgroundBrush}"
                            BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"
                            Padding="10,7" CornerRadius="10,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="FILES" FontSize="11" FontWeight="Bold"
                                       VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"
                                       Margin="4,0,10,0" />

                            <!-- Select All + Refresh (only when project loaded) -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="AllButton" Content="All"
                                        Padding="4,2" FontSize="10"
                                        ToolTip="Select All (Skeleton) → Select All (Full) → Clear"
                                        Click="AllButton_Click"
                                        Visibility="Collapsed" />
                                <Button x:Name="RefreshButton" Content="↻"
                                        Padding="4,2" FontSize="12" Margin="4,0,0,0"
                                        ToolTip="Rescan project folder"
                                        Click="RefreshButton_Click"
                                        Visibility="Collapsed" />
                            </StackPanel>

                            <!-- Open / Change folder -->
                            <Button Grid.Column="2" x:Name="ChangeButton" Padding="8,3" Margin="4,0,0,0"
                                    ToolTip="Open a B4X project folder"
                                    Click="ChangeButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="ChangeButtonText" Text="Open" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- File count badge (only when project loaded) -->
                            <Border Grid.Column="3" Background="{StaticResource BadgeBrush}"
                                    CornerRadius="4" Padding="6,1" Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    x:Name="FileCountBadgeBorder" Visibility="Collapsed">
                                <TextBlock x:Name="FileCountBadge" Text="0" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Empty state (shown when no project loaded) -->
                    <Grid x:Name="EmptyStatePanel" Grid.Row="1" Visibility="Visible">
                        <Button Click="ChangeButton_Click" Cursor="Hand"
                                Background="Transparent" BorderThickness="0"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="Transparent">
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-40,0,0">
                                                        <Border x:Name="IconCircle" Background="#FFE8EDF2" CornerRadius="20" Width="64" Height="64"
                                                                HorizontalAlignment="Center" Margin="0,0,0,12">
                                                            <Path x:Name="FolderIcon" Data="M2,4 L2,20 L22,20 L22,6 L12,6 L10,4 Z"
                                                                  Fill="#FF5B6A78" Stretch="Uniform"
                                                                  Width="28" Height="28" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                        </Border>
                                                        <TextBlock x:Name="TitleText" Text="No project loaded" FontSize="13" FontWeight="Bold"
                                                                   Foreground="#FF2A3947" HorizontalAlignment="Center" />
                                                        <TextBlock x:Name="SubText" Text="Click to open a folder" FontSize="11"
                                                                   Foreground="#FF5B6A78" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="IconCircle" Property="Background" Value="{StaticResource AccentBrush}" />
                                                        <Setter TargetName="FolderIcon" Property="Fill" Value="White" />
                                                        <Setter TargetName="TitleText" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                        <Setter TargetName="SubText" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#FFE8EDF2" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- Files list -->
                    <ListView x:Name="FilesListView" Grid.Row="1" Margin="0" Background="{StaticResource CardBackgroundBrush}"
                              Visibility="Collapsed">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Chevron expander (Custom mode only) -->
                                    <Button Grid.Row="0" Grid.Column="0"
                                            Click="ToggleExpand_Click"
                                            Width="20" Height="20" Margin="0,0,2,0"
                                            VerticalAlignment="Center"
                                            ToolTip="Expand granular selection">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                                <Setter Property="Content" Value="▸" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                        <Setter Property="Content" Value="▾" />
                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsCodeFile}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Mode}" Value="Skeleton">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Mode}" Value="Full">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- Checkbox -->
                                    <CheckBox Grid.Row="0" Grid.Column="1"
                                              IsChecked="{Binding Included, Mode=TwoWay}"
                                              Margin="2,0,0,0" VerticalAlignment="Center"
                                              Checked="FileInclude_Checked" Unchecked="FileInclude_Checked" />

                                    <!-- Extension badge -->
                                    <Border Grid.Row="0" Grid.Column="2"
                                            Style="{StaticResource FileTypeBadge}" Margin="6,0,0,0">
                                        <TextBlock Text="{Binding Kind}" FontSize="8.5" FontWeight="Bold"
                                                   Foreground="#FF1A1C2A" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Border>

                                    <!-- File name + directory -->
                                    <StackPanel Grid.Row="0" Grid.Column="3" Margin="8,0,6,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="13"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                   FontWeight="Medium" />
                                        <TextBlock Text="{Binding Directory}" Style="{StaticResource DirectoryTextStyle}"
                                                   Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <!-- Mode toggle (Skeleton/Full/Custom) -->
                                    <Button Grid.Row="0" Grid.Column="4"
                                            Content="{Binding Mode}" Click="ToggleMode_Click"
                                            Margin="0,0,4,0" VerticalAlignment="Center"
                                            Style="{StaticResource ModeToggleButton}" />

                                    <!-- Reset selection -->
                                    <Button Grid.Row="0" Grid.Column="5"
                                            Click="ResetCustom_Click"
                                            Margin="0,0,6,0" VerticalAlignment="Center"
                                            Style="{StaticResource ReselectionButton}" />

                                    <!-- Expandable items panel (Custom mode only) -->
                                    <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5"
                                          Background="{StaticResource ItemPanelBrush}" CornerRadius="6"
                                          Margin="6,0,8,6" Padding="10,8">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsExpanded}" Value="True" />
                                                            <Condition Binding="{Binding Mode}" Value="Custom" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="SUBS" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,2">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasSubs}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <ItemsControl ItemsSource="{Binding ItemsSubs}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox Content="{Binding Signature}"
                                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                      Checked="Item_Checked" Unchecked="Item_Checked"
                                                                      FontSize="11.5" FontFamily="Consolas" Margin="2,1" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <StackPanel Margin="0,8,0,0">
                                                <TextBlock Text="VARIABLES" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,2">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasVariables}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <ItemsControl ItemsSource="{Binding ItemsVariables}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox Content="{Binding Signature}"
                                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                      Checked="Item_Checked" Unchecked="Item_Checked"
                                                                      FontSize="11.5" FontFamily="Consolas" Margin="2,1" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <StackPanel Margin="0,8,0,0">
                                                <TextBlock Text="TYPES" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,2">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasTypes}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <ItemsControl ItemsSource="{Binding ItemsTypes}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox Content="{Binding Signature}"
                                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                      Checked="Item_Checked" Unchecked="Item_Checked"
                                                                      FontSize="11.5" FontFamily="Consolas" Margin="2,1" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <StackPanel Margin="0,8,0,0">
                                                <TextBlock Text="REGIONS" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,2">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasRegions}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <ItemsControl ItemsSource="{Binding ItemsRegions}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox Content="{Binding Signature}"
                                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                      Checked="Item_Checked" Unchecked="Item_Checked"
                                                                      FontSize="11.5" FontFamily="Consolas" Margin="2,1" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- ============================================================
                 RIGHT — CONTEXT & GOAL + PACK SUMMARY
                 ============================================================ -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0">
                    <StackPanel Margin="0,0,0,12">

                        <!-- CARD: Context & Goal -->
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Context &amp; Goal" Style="{StaticResource HeaderTextStyle}" />
                                <Border Style="{StaticResource SectionDivider}" />

                                <!-- Preamble / Working Context -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="PREAMBLE / CONTEXT" FontSize="11" FontWeight="Bold"
                                               Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4" />
                                    <Grid Grid.Row="1">
                                        <TextBox x:Name="PreambleText" Height="160" TextWrapping="Wrap"
                                                 TextChanged="PreambleOrTask_TextChanged" />
                                        <TextBlock Text="Describe your project stack, conventions, or specific requirements…"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Margin="12,10,12,0" VerticalAlignment="Top" HorizontalAlignment="Left"
                                                   IsHitTestVisible="False" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=PreambleText}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Grid>

                                <!-- Task / Query -->
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="TASK / QUERY" FontSize="11" FontWeight="Bold"
                                               Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4" />
                                    <Grid Grid.Row="1">
                                        <TextBox x:Name="TaskText" Height="80" TextWrapping="Wrap"
                                                 TextChanged="PreambleOrTask_TextChanged" />
                                        <TextBlock Text="What should the AI do with this context?"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Margin="12,10,12,0" VerticalAlignment="Top" HorizontalAlignment="Left"
                                                   IsHitTestVisible="False" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=TaskText}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- CARD: Pack Summary — 3-column grid (PromptPacker style) -->
                        <Border Style="{StaticResource CardBorderStyle}" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Pack Summary" Style="{StaticResource HeaderTextStyle}" />
                                <Border Style="{StaticResource SectionDivider}" Margin="0,10,0,12" />

                                <!-- 3-column stats -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Files Selected -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="FILES SELECTED" FontSize="10" FontWeight="Bold"
                                                   Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,2" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="FilesSelectedText" Text="0" FontSize="22" FontWeight="Bold"
                                                       Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,6,0" />
                                            <TextBlock Text="total" FontSize="11" Foreground="{StaticResource MutedTextBrush}"
                                                       VerticalAlignment="Bottom" Margin="0,0,0,4" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Estimated Tokens + Compression -->
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock Text="ESTIMATED TOKENS" FontSize="10" FontWeight="Bold"
                                                   Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,2" />
                                        <TextBlock x:Name="EstimatedTokensText" Text="~0" FontSize="22" FontWeight="Bold"
                                                   Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" />
                                        <TextBlock x:Name="CompressionText" Text="" FontSize="10"
                                                   Foreground="{StaticResource StatusSuccessBrush}" Margin="0,2,0,0"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>

                                    <!-- File tree toggle -->
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                        <TextBlock Text="OPTIONS" FontSize="10" FontWeight="Bold"
                                                   Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6" />
                                        <CheckBox x:Name="FileTreeToggle" Content="Include file tree"
                                                  Style="{StaticResource ToggleSwitchStyle}"
                                                  Checked="FileTreeToggle_Changed" Unchecked="FileTreeToggle_Changed" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- Empty state prompt when no project loaded -->
                <TextBlock Grid.Row="0" x:Name="EmptyStateText"
                           Text="Open a project folder to get started"
                           Foreground="{StaticResource MutedTextBrush}" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed" />
            </Grid>
        </Grid>

        <!-- ============================================================
             BOTTOM ACTION FOOTER (PromptPacker style)
             ============================================================ -->
        <Border Grid.Row="1" Background="{StaticResource StatusBarBackgroundBrush}"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0"
                Padding="16,9,16,10" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Build status + Compile -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Settings gear -->
                    <Button x:Name="SettingsButton" Content="⚙" Width="28" Height="26"
                            FontSize="13" Padding="0" Margin="0,0,10,0"
                            Background="Transparent" BorderBrush="{StaticResource DividerBrush}"
                            ToolTip="Hotkey settings" Click="SettingsButton_Click" />

                    <!-- Build status indicator -->
                    <Border Background="{StaticResource CardBackgroundBrush}"
                            CornerRadius="6" Padding="10,5,14,5" BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource MutedTextBrush}" Margin="0,0,8,0" />
                            <TextBlock x:Name="CompileStatusText" Text="Ready" FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Compile button -->
                    <Button x:Name="CompileButton" Content="Compile &amp; Check"
                            Padding="12,5" FontSize="12"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="CompileButton_Click" />
                </StackPanel>

                <!-- Right: Generate Prompt -->
                <Button Grid.Column="2" x:Name="GenerateButton" Content="▶  Generate Prompt"
                        Padding="14,7" Style="{StaticResource PrimaryButtonStyle}"
                        IsEnabled="False"
                        Click="GenerateButton_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
