<Window x:Class="b4x_context.HotkeySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hotkey Settings" Width="440" SizeToContent="Height" MinHeight="280"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        TextOptions.TextFormattingMode="Ideal">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Current hotkey display -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Shortcut Key" Style="{StaticResource HeaderTextStyle}" />
            <TextBlock x:Name="CurrentHotkeyText" Style="{StaticResource SubHeaderTextStyle}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Capture card -->
        <Border Grid.Row="1" Margin="0,12,0,0" Style="{StaticResource CardBorderStyle}" Padding="10">
            <StackPanel>
                <TextBlock Text="Press a new key combination" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,8" />
                <Border Background="{StaticResource InputBackgroundBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="10">
                    <TextBox x:Name="CaptureBox"
                             Text="Click here, then press a key combo…"
                             IsReadOnly="True"
                             FontSize="15" FontWeight="SemiBold"
                             HorizontalAlignment="Center" TextAlignment="Center"
                             Background="Transparent" BorderThickness="0"
                             PreviewMouseDown="CaptureBox_PreviewMouseDown"
                             PreviewKeyDown="CaptureBox_PreviewKeyDown" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Error text -->
        <TextBlock x:Name="ErrorText" Grid.Row="2"
                   Foreground="{StaticResource StatusErrorBrush}"
                   Visibility="Collapsed" TextWrapping="Wrap"
                   Margin="0,10,0,0" FontSize="12" />

        <!-- Spacer -->
        <Grid Grid.Row="3" />

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="ResetButton" Content="⟲  Reset Default"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,10,0" Click="ResetButton_Click" />
            <Button x:Name="SaveButton" Content="Save"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Margin="0,0,8,0" Click="SaveButton_Click" />
            <Button x:Name="CancelButton" Content="Cancel"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>
