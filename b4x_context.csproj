<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Application icon (embedded in Win32 resources) -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ensure the icon file is included in the project and copied to output for tooling/runtime -->
    <None Include="Assets\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Keep the test project out of the app project's default ourselves globbing -->
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
    <Content Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
    <Page Remove="tests\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keep the spike probe tool out of the app project's default globbing -->
    <Compile Remove="tools\**" />
    <None Remove="tools\**" />
    <Content Remove="tools\**" />
    <EmbeddedResource Remove="tools\**" />
    <Page Remove="tools\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Multi-language tree-sitter support (per-language grammars native for win-x64) -->
    <PackageReference Include="SharpToken" Version="2.0.6" />
    <PackageReference Include="TreeSitter.DotNet" Version="1.3.0" />
  </ItemGroup>

  <!-- Publish defaults: framework-dependent folder build (.NET 10 Desktop Runtime required on target) -->
  <PropertyGroup>
    <!-- Default to Release when no configuration supplied -->
    <Configuration Condition="'$(Configuration)'==''">Release</Configuration>

    <!-- Target Windows x64 runtime by default -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- Framework-dependent (user installs .NET Desktop Runtime 10); plain folder output -->
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>

    <!-- R2R for faster startup (crossgen compiles app assemblies only in framework-dependent mode) -->
    <_SuppressWpfTrimError>true</_SuppressWpfTrimError>
    <PublishReadyToRun>true</PublishReadyToRun>

    <!-- Disable debug symbols for production publish -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <None Include=".github\workflows\release.yml" />
  </ItemGroup>

  <!-- Ship only the tree-sitter grammars the app actually uses. TreeSitter.DotNet
       copies ~30 per-language grammars; the unused ones (~50 MB: verilog, razor,
       agda, swift, ruby, ...) are pruned from the publish folder. Normal builds
       and test runs keep all grammars so the skeleton tests stay green.
       `tree-sitter.dll` (the core) is NOT matched by the tree-sitter-*.dll glob. -->
  <Target Name="PruneUnusedTreeSitterGrammars" AfterTargets="Publish">
    <ItemGroup>
      <_UnusedGrammar Include="$(PublishDir)tree-sitter-*.dll"
          Exclude="$(PublishDir)tree-sitter-c.dll;$(PublishDir)tree-sitter-c-sharp.dll;$(PublishDir)tree-sitter-css.dll;$(PublishDir)tree-sitter-go.dll;$(PublishDir)tree-sitter-html.dll;$(PublishDir)tree-sitter-java.dll;$(PublishDir)tree-sitter-javascript.dll;$(PublishDir)tree-sitter-json.dll;$(PublishDir)tree-sitter-python.dll;$(PublishDir)tree-sitter-rust.dll;$(PublishDir)tree-sitter-tsx.dll;$(PublishDir)tree-sitter-typescript.dll" />
    </ItemGroup>
    <Delete Files="@(_UnusedGrammar)" />
  </Target>

</Project>
