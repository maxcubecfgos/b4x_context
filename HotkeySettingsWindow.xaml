<Window x:Class="b4x_context.HotkeySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="460" SizeToContent="Height" MinHeight="280"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        TextOptions.TextFormattingMode="Ideal">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Current hotkey display -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Shortcut Key" Style="{StaticResource HeaderTextStyle}" />
            <TextBlock x:Name="CurrentHotkeyText" Style="{StaticResource SubHeaderTextStyle}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Capture card -->
        <Border Grid.Row="1" Margin="0,12,0,0" Style="{StaticResource CardBorderStyle}" Padding="10">
            <StackPanel>
                <TextBlock Text="Press a new key combination" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,8" />
                <Border Background="{StaticResource InputBackgroundBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="10">
                    <TextBox x:Name="CaptureBox"
                             Text="Click here, then press a key combo…"
                             IsReadOnly="True"
                             FontSize="15" FontWeight="SemiBold"
                             HorizontalAlignment="Center" TextAlignment="Center"
                             Background="Transparent" BorderThickness="0"
                             PreviewMouseDown="CaptureBox_PreviewMouseDown"
                             PreviewKeyDown="CaptureBox_PreviewKeyDown" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Local AI: context size slider + endpoint/model -->
        <Border Grid.Row="2" Margin="0,12,0,0" Style="{StaticResource CardBorderStyle}" Padding="10">
            <StackPanel>
                <TextBlock Text="Local AI — context &amp; endpoint" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,8" />

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Context window" FontSize="12" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Background="{StaticResource BadgeBrush}" CornerRadius="4" Padding="8,2">
                        <TextBlock x:Name="ContextValueText" FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" />
                    </Border>
                </Grid>

                <Slider x:Name="ContextSlider" Minimum="0" Maximum="10"
                        TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                        Margin="0,0,0,4" Value="2" ValueChanged="ContextSlider_ValueChanged" />
                <TextBlock x:Name="ContextHintText" FontSize="10.5"
                           Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,10" TextWrapping="Wrap" />

                <TextBlock Text="Endpoint (OpenAI-compatible)" FontSize="12" Margin="0,0,0,4" />
                <TextBox x:Name="EndpointBox" Padding="8,5" FontSize="12"
                         ToolTip="e.g. http://localhost:11434/v1 (Ollama) or http://localhost:1234/v1 (LM Studio)" />

                <TextBlock Text="Model" FontSize="12" Margin="0,8,0,4" />
                <ComboBox x:Name="ModelBox" IsEditable="False"
                          MinHeight="34" HorizontalAlignment="Stretch"
                          ToolTip="Model served by the endpoint — click to open the list (fetched from the server when Settings opens)" />
                <TextBlock x:Name="ModelStatusText" FontSize="10.5"
                           Foreground="{StaticResource MutedTextBrush}"
                           Margin="0,5,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Error text -->
        <TextBlock x:Name="ErrorText" Grid.Row="3"
                   Foreground="{StaticResource StatusErrorBrush}"
                   Visibility="Collapsed" TextWrapping="Wrap"
                   Margin="0,10,0,0" FontSize="12" />

        <!-- Spacer -->
        <Grid Grid.Row="4" />

        <!-- Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="ResetButton" Content="⟲  Reset Default"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,10,0" Click="ResetButton_Click" />
            <Button x:Name="SaveButton" Content="Save"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Margin="0,0,8,0" Click="SaveButton_Click" />
            <Button x:Name="CancelButton" Content="Cancel"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>
