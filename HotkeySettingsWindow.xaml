<Window x:Class="b4x_context.HotkeySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hotkey Settings" Width="420" Height="220" WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="CurrentHotkeyText" Grid.Row="0" FontWeight="Bold" />

        <Border Grid.Row="1" Margin="0,8,0,0" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="6">
            <TextBox x:Name="CaptureBox" Text="Click here, then press a key combo…" IsReadOnly="True" PreviewMouseDown="CaptureBox_PreviewMouseDown" PreviewKeyDown="CaptureBox_PreviewKeyDown"/>
        </Border>

        <TextBlock x:Name="ErrorText" Grid.Row="2" Foreground="OrangeRed" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,8,0,0" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="ResetButton" Content="Reset to Default" Margin="0,0,8,0" Click="ResetButton_Click" />
            <Button x:Name="SaveButton" Content="Save" Margin="0,0,8,0" Click="SaveButton_Click" />
            <Button x:Name="CancelButton" Content="Cancel" Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>
