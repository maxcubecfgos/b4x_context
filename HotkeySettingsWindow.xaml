<Window x:Class="b4x_context.HotkeySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hotkey Settings" Width="420" Height="230" WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}"
        TextOptions.TextFormattingMode="Ideal">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="CurrentHotkeyText" Grid.Row="0" Style="{StaticResource HeaderTextStyle}" />

        <Border Grid.Row="1" Margin="0,10,0,0" Style="{StaticResource CardBorderStyle}" Padding="8">
            <StackPanel>
                <TextBlock Text="Press a new key combination" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,6" />
                <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8"
                        Background="{StaticResource InputBackgroundBrush}">
                    <TextBox x:Name="CaptureBox"
                             Text="Click here, then press a key combo…"
                             IsReadOnly="True"
                             FontSize="14"
                             FontWeight="SemiBold"
                             HorizontalAlignment="Center"
                             TextAlignment="Center"
                             Background="Transparent"
                             BorderThickness="0"
                             PreviewMouseDown="CaptureBox_PreviewMouseDown"
                             PreviewKeyDown="CaptureBox_PreviewKeyDown" />
                </Border>
            </StackPanel>
        </Border>

        <TextBlock x:Name="ErrorText" Grid.Row="2"
                   Foreground="{StaticResource StatusErrorBrush}"
                   Visibility="Collapsed" TextWrapping="Wrap" Margin="0,8,0,0"
                   FontSize="12" />

        <!-- Spacer row -->
        <Grid Grid.Row="3" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="ResetButton" Content="Reset to Default" Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,10,0" Click="ResetButton_Click" />
            <Button x:Name="SaveButton" Content="Save" Style="{StaticResource PrimaryButtonStyle}"
                    Margin="0,0,8,0" Click="SaveButton_Click" />
            <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource SecondaryButtonStyle}"
                    Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>
