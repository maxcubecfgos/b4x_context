<Application x:Class="b4x_context.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:b4x_context"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Dark theme resources -->
        <Color x:Key="WindowBgColor">#FF1E1E2E</Color>
        <Color x:Key="CardBgColor">#FF252537</Color>
        <Color x:Key="CardBorderColor">#FF3A3A4D</Color>
        <Color x:Key="PrimaryTextColor">#FFCDD6F4</Color>
        <Color x:Key="MutedTextColor">#FF8891B0</Color>
        <Color x:Key="AccentColor">#FF89B4FA</Color>
        <Color x:Key="InputBgColor">#FF181825</Color>
        <Color x:Key="SkeletonTint">#FF264A6E</Color>
        <Color x:Key="FullTint">#FF2F6F4E</Color>

        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBgColor}" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBgColor}" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
        <!-- Dark accent variants for buttons (high-contrast for white text) -->
        <Color x:Key="AccentDarkColor">#FF2563EB</Color>
        <Color x:Key="AccentDarkHoverColor">#FF1E40AF</Color>
        <Color x:Key="AccentDarkPressedColor">#FF1E3A8A</Color>
        <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}" />
        <SolidColorBrush x:Key="AccentDarkHoverBrush" Color="{StaticResource AccentDarkHoverColor}" />
        <SolidColorBrush x:Key="AccentDarkPressedBrush" Color="{StaticResource AccentDarkPressedColor}" />
        <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource InputBgColor}" />
        <SolidColorBrush x:Key="SkeletonBrush" Color="{StaticResource SkeletonTint}" />
        <SolidColorBrush x:Key="FullBrush" Color="{StaticResource FullTint}" />

        <!-- Card style -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8" />
        </Style>

        <!-- TextBlock default -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        </Style>

        <!-- Implicit Button style (dark-themed default) with explicit ControlTemplate so hover/pressed visuals are controlled -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="Cp"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentDarkHoverBrush}" />
                                <Setter TargetName="Cp" Property="TextElement.Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentDarkPressedBrush}" />
                                <Setter TargetName="Cp" Property="TextElement.Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Implicit Label style -->
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        </Style>

        <!-- Implicit CheckBox style (text color) -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        </Style>

        <!-- Implicit ListView style -->
        <Style TargetType="ListView">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- Implicit ListViewItem style -->
        <Style TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Padding" Value="4" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource WindowBackgroundBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Implicit ScrollBar style (simple) -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        </Style>

        <!-- Implicit Border style: default to transparent unless CardBorderStyle is used -->
        <Style TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        </Style>

        <!-- Badge brush for counters -->
        <SolidColorBrush x:Key="BadgeBrush" Color="#FF2B3B50" />

        <!-- Muted label -->
        <Style x:Key="MutedLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- TextBox style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Primary button style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentDarkBrush}" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentDarkBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <!-- Rely on the ControlTemplate in the base Button style so hover/pressed target the template elements -->
        </Style>

        <!-- Mode toggle button style: color based on Mode text -->
        <Style x:Key="ModeToggleButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Mode}" Value="Skeleton">
                    <Setter Property="Background" Value="{StaticResource SkeletonBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Mode}" Value="Full">
                    <Setter Property="Background" Value="{StaticResource FullBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
